  m_Name: C06_TheSecretPassword
  m_EditorClassIdentifier: Assembly-CSharp::MissionDefinition
  SenderImage: {fileID: -6791768151144676940, guid: d8a8af84dba3b7d15ab10b2ef0b7fb99, type: 3}
  SenderName: Rizky
  ShortDescription: Shhh, it's a secret! Let's see if your computer knows the password.
  MissionId: C06
  MissionTitle: The Secret Password
  Objective: A locked terminal guards a mysterious secret. Enter the correct password,
    kancil, to unlock it! Print Access granted for the correct password and Access
    denied otherwise.
  Hint: Store the result of input() in a variable and compare it with "kancil".s
  PlaceholderCode: "password = input()\n\nif password == \"kancil\":\n    print(\"Access
    Denied\")\nelse:\n    print(\"Access Granted\")"
  Solution: "password = input()\n\nif password == \"kancil\":\n    print(\"Access
    Granted\")\nelse:\n    print(\"Access Denied\")"
  TestCases:
  - Input: kancil
    ExpectedOutput: Access Granted
  - Input: hello
    ExpectedOutput: Access Denied
  - Input: Kancil
    ExpectedOutput: Access Denied
