  SenderImage: {fileID: -1786714882658831939, guid: fb5842c63cd725426b3b779dc2dcd699, type: 3}
  SenderName: Vino
  ShortDescription: Time to multiply! Let's see how far your computer can count.
  MissionId: C07
  MissionTitle: The Multiplication Machine
  Objective: Your multiplication machine is ready! Read a number and print its first
    five multiples, one per line. Let's see how high it can count!
  Hint: 'Use for i in range(1, 6): and calculate n * i.'
  PlaceholderCode: "n = int(input())\n\nfor i in range(1, 6):\n    print(n)"
  Solution: "n = int(input())\n\nfor i in range(1, 6):\n    print(n * i)"
  TestCases:
  - Input: 3
    ExpectedOutput: '3

      6

      9

      12

      15'
  - Input: 
    ExpectedOutput: 
