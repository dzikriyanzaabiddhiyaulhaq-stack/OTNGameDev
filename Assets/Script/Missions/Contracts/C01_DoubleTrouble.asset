  SenderImage: {fileID: -492787555904600777, guid: a46051a4bc9135d2ca781fd32501c108, type: 3}
  SenderName: Abid
  ShortDescription: Double the number, double the fun! Let's see what your computer
    can do.
  MissionId: C01
  MissionTitle: Double Trouble
  Objective: A number has arrived, and it needs a partner twice its size! Read an
    integer and print its double. Let's see those numbers grow!
  Hint: Multiply the input by 2.
  PlaceholderCode: 'number = int(input())

    print(number)'
  Solution: 'number = int(input())

    print(number * 2)'
  TestCases:
  - Input: 3
    ExpectedOutput: 6
  - Input: 0
    ExpectedOutput: 0
  - Input: 5
    ExpectedOutput: 10
