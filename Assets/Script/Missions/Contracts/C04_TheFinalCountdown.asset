  m_Name: C04_TheFinalCountdown
  m_EditorClassIdentifier: Assembly-CSharp::MissionDefinition
  SenderImage: {fileID: -703553564653378453, guid: 89b7e93cb414c281f83752555b64c4b6, type: 3}
  SenderName: Fatir
  ShortDescription: Ready for launch? Let's get counting before blast-off!
  MissionId: C04
  MissionTitle: The Final Countdown
  Objective: Engines ready? Check! Destination locked? Check! Use a while loop to
    count down from 5 to 1, printing each number on its own line. Blast off!
  Hint: Keep looping while the counter is greater than zero, and decrease it each
    time.
  PlaceholderCode: "count = 5\n\nwhile count > 0:\n    print(count)\n    count =
    count - 1"
  Solution: "count = 5\n\nwhile count > 0:\n    print(count)\n    count = count -
    1"
  TestCases:
  - Input: 
    ExpectedOutput: '5

      4

      3

      2

      1'
